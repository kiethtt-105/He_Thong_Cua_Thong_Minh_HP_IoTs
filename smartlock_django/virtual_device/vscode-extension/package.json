{
  "name": "smartlock-virtual-lock",
  "displayName": "Smartlock Virtual Lock",
  "version": "0.2.0",
  "publisher": "local",
  "engines": { "vscode": "^1.80.0" },
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": { "activitybar": [{ "id": "smartlock", "title": "Smartlock", "icon": "media/icon.svg" }] },
    "views": { "smartlock": [{ "type": "webview", "id": "smartlockVirtual.view", "name": "Khoá ảo" }] },
    "configuration": {
      "title": "Smartlock Virtual Lock",
      "properties": {
        "smartlockVirtual.pythonPath": { "type": "string", "default": "python", "description": "Python có cài paho-mqtt" },
        "smartlockVirtual.deviceDir": { "type": "string", "default": "", "description": "Thư mục chứa virtual_lock.py (trống = tự tìm). Code/secret đọc từ .env trong thư mục đó." }
      }
    }
  }
}
