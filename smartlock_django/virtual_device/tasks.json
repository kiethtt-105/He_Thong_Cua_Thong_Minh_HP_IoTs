{
  "version": "2.0.0",
  "tasks": [
    { "label": "Khoá ảo: tạo khoá mới (provision)", "type": "shell",
      "command": "python -m virtual_device provision --profile default --name \"Khoá ảo\" --force",
      "problemMatcher": [] },
    { "label": "Khoá ảo: giao diện", "type": "shell",
      "command": "python -m virtual_device ui --profile default",
      "isBackground": true, "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" } },
    { "label": "Khoá ảo: gán cho admin (claim)", "type": "shell",
      "command": "python -m virtual_device claim --profile default --admin ${input:adminEmail} --ping",
      "problemMatcher": [] },
    { "label": "Cài thư viện khoá ảo", "type": "shell",
      "command": "pip install -r virtual_device/requirements.txt", "problemMatcher": [] }
  ],
  "inputs": [
    { "id": "adminEmail", "type": "promptString", "description": "Email tài khoản admin" }
  ]
}
