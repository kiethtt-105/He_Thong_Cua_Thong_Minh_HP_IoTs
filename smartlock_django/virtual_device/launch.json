{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Khoá ảo: giao diện web",
      "type": "debugpy", "request": "launch", "module": "virtual_device",
      "args": ["ui", "--profile", "default", "--port", "8765"],
      "cwd": "${workspaceFolder}", "console": "integratedTerminal", "justMyCode": true
    },
    {
      "name": "Khoá ảo: dòng lệnh (REPL)",
      "type": "debugpy", "request": "launch", "module": "virtual_device",
      "args": ["run", "--profile", "default"],
      "cwd": "${workspaceFolder}", "console": "integratedTerminal"
    },
    {
      "name": "Server: mqtt_subscriber",
      "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/manage.py",
      "args": ["mqtt_subscriber"], "console": "integratedTerminal"
    },
    {
      "name": "Server: runserver",
      "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/manage.py",
      "args": ["runserver", "--noreload"], "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Cả hệ thống: subscriber + khoá ảo (UI)",
      "configurations": ["Server: mqtt_subscriber", "Khoá ảo: giao diện web"],
      "stopAll": true
    }
  ]
}
