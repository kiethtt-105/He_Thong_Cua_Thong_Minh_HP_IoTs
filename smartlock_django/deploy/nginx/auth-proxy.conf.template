# Broker -> (nginx, tự thêm X-Webhook-Secret) -> Django.
# Plugin go-auth không chắc hỗ trợ header tuỳ biến, nên để nginx chèn giúp.
# Biến ${...} do envsubst của image nginx điền lúc khởi động.
server {
    listen 8080;

    # Chỉ cho đúng 3 đường dẫn webhook, còn lại 404.
    location = /api/mqtt/superuser/ { return 403; }     # không có "superuser" trong thiết kế này

    location ~ ^/api/mqtt/(auth|acl)/$ {
        proxy_pass ${DJANGO_UPSTREAM};
        proxy_set_header Host ${DJANGO_HOST};
        proxy_set_header X-Webhook-Secret ${MQTT_WEBHOOK_SECRET};
        proxy_ssl_server_name on;                         # cần khi upstream là https (vd. Vercel)
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }

    location / { return 404; }
}
